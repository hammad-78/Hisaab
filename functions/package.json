{
  "name": "hisaab-functions",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "tsc -p tsconfig.test.json && mocha lib/test/**/*.test.js --timeout 10000",
    "test:rules:unit": "tsc -p tsconfig.test.json && mocha lib/test/firestore.rules.test.js --timeout 10000",
    "test:rules": "firebase emulators:exec --project demo-hisaab-security-rules --only firestore \"npm run test:rules:unit\""
  },
  "engines": {
    "node": "20"
  },
  "type": "commonjs",
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "chai": "^4.4.1",
    "firebase-functions-test": "^3.1.0",
    "firebase": "12.19.0",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "private": true
}
