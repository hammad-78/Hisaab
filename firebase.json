{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "hisab-f9902",
          "appId": "1:468792096069:android:2f8d53ea3171a9bdb77a2c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "hisab-f9902",
          "configurations": {
            "android": "1:468792096069:android:2f8d53ea3171a9bdb77a2c",
            "ios": "1:468792096069:ios:4d74dcff8a245980b77a2c",
            "macos": "1:468792096069:ios:4d74dcff8a245980b77a2c",
            "web": "1:468792096069:web:8e06369edbe766eab77a2c",
            "windows": "1:468792096069:web:6c61f086b99a2ab0b77a2c"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}